+"""Exact CUDA-graph replay of the SDARPrefixKV commit forward (commit_mode=causal).
+
+The commit pass re-runs the finished block (block_size clean tokens, causal
+within the block, full prefix K/V) once per block to write the final K/V and
+the boundary logits of the next block. It goes through the generic extend path
+of the flashinfer backend (ragged wrapper over the block + paged wrapper over
+the prefix + merge_state) and was forced eager (disable_cuda_graph_once), which
+costs ~16 ms per block on H100 for a 4B model against ~7.5 ms of GPU work.
+
+This module captures that eager forward (bs=1, extend == block_size) with two
+DEDICATED flashinfer wrappers in the SAME (non-cuda-graph) mode the eager path
+uses, so plan + kernels are identical to eager. Every block re-plans both
+wrappers on the host through the backend's own init_forward_metadata (the plan
+writes indptr/indices into the backend's stable device buffers and the int
+workspace the captured kernels read by pointer), copies the block inputs into
+the static tensors and replays. flashinfer's host-side plan_info (baked into
+the captured launches) changes with the kv length only for very short
+prefixes, so graphs are cached per (paged, ragged) plan_info signature; a new
+signature triggers a new capture. Every capture compares replay vs eager
+bitwise (logits + K/V of the block slots) and disables itself on mismatch.
+Note: cuda-graph-mode wrappers were tried first and compute a DIFFERENT (wrong)
+attention for this ragged+paged commit pass (flashinfer 0.6.12) -- do not use.
+
+SDAR_COMMIT_GRAPH=1 (default) enables it (SDARPrefixKV._run_impl commit branch); 0 restores the eager commit.
+SDAR_COMMIT_GRAPH_MAX_KV is a FLOOR for the prefill updater's kv_indices scratch capacity; the effective
+capacity is max(floor, context_len + 256 + block_size) so the eager updater (needed = paged_len + 256,
+flashinfer_backend.call_begin_forward) never reallocates the scratch the captured kernels point at. If it
+ever does move, run() detects the new data_ptr before replaying, retires the whole graph generation
+(graphs + private pool + cached output) and recaptures on the current buffer.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import logging
+import os
+import time
+from typing import Any
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_ENABLED = os.environ.get("SDAR_COMMIT_GRAPH", "1") == "1"
+# floor for the capacity (tokens) of the prefill updater's kv_indices scratch
+# that the captured kernels hold by pointer. The effective capacity is
+# max(this, context_len + 256 (the updater's slack) + block_size) so the eager
+# updater never has to reallocate the scratch for any forward the server can
+# issue (a reallocation would leave every captured graph with a dangling
+# pointer -> illegal memory access on the next replay; seen at the 32k protocol
+# with the old fixed 32768 cap).
+_MAX_KV = int(os.environ.get("SDAR_COMMIT_GRAPH_MAX_KV", "32768") or 32768)
+# debug: after every replay also run the eager commit and compare logits + K/V
+_CHECK_EVERY = os.environ.get("SDAR_COMMIT_GRAPH_CHECK", "0") == "1"
+
+
+@dataclasses.dataclass
+class _Result:
+    logits_output: Any
+    graph_was_replayed: bool = True
+    graph_replay_miss_reason: str | None = None
+    can_run_graph: bool = True
+
+
+class ExactCommitGraphs:
+    def __init__(self, block_size: int, check_layers: int = 3):
+        self.block_size = int(block_size)
+        self.graphs: dict[tuple, dict] = {}  # plan signature -> {graph, out}
+        self.fb_static = None
+        self.wrappers = None  # (ragged, paged_list) dedicated wrappers, eager mode
+        self.pool = None
+        self.stream = None
+        self.disabled = not _ENABLED
+        self.disabled_reason: str | None = None
+        self.check_layers = check_layers
+        self.stats = {"replays": 0, "captures": 0, "capture_s": 0.0, "scratch_moved": 0}
+        # capacity (tokens) of the updater's kv_indices scratch and its pointer at
+        # the time the graphs were captured (see _make_wrappers / _scratch_ok)
+        self._kv_cap: int | None = None
+        self._kv_buf_ptr: int | None = None
+
+    # ------------------------------------------------------------------
+    def applicable(self, forward_batch, trace: bool) -> bool:
+        if self.disabled or trace:
+            return False
+        if int(forward_batch.batch_size) != 1:
+            return False
+        if getattr(forward_batch, "input_embeds", None) is not None:
+            return False
+        if not forward_batch.forward_mode.is_dllm_extend():
+            return False
+        if not getattr(forward_batch, "dllm_is_commit", False):
+            return False
+        if not getattr(forward_batch, "dllm_force_causal", False):
+            return False
+        if getattr(forward_batch, "dllm_is_denoise", False):
+            return False
+        if int(forward_batch.input_ids.numel()) != self.block_size:
+            return False
+        pre = forward_batch.extend_prefix_lens_cpu
+        if not pre or int(pre[0]) <= 0:
+            return False
+        cap = self._kv_cap
+        if cap is None:  # wrappers not built yet: same formula _make_wrappers will use
+            be = getattr(forward_batch, "attn_backend", None)
+            ctx = int(getattr(be, "max_context_len", 0) or 0)
+            cap = max(_MAX_KV, ctx + 256 + self.block_size) if ctx else _MAX_KV
+        # the commit plan is ragged: the updater needs prefix + 256 = seq - block + 256 entries
+        if int(forward_batch.seq_lens_sum) - self.block_size + 256 > cap:
+            return False
+        if not forward_batch.input_ids.is_cuda:
+            return False
+        return True
+
+    # ------------------------------------------------------------------
+    def _signature(self):
+        ragged, paged = self.wrappers
+        return (tuple(int(x) for x in ragged._plan_info),) + tuple(
+            tuple(int(x) for x in w._plan_info) for w in paged
+        )
+
+    def run(self, model_runner, forward_batch):
+        """Replay (capture on first sight of a plan signature). None when disabled."""
+        try:
+            if self.fb_static is None:
+                self.fb_static = self._make_static(forward_batch)
+                self._ensure_wrappers(model_runner, forward_batch.input_ids.device)
+            self._sync_static(self.fb_static, forward_batch)
+            self._plan(model_runner, self.fb_static)
+            sig = self._signature()
+        except Exception as exc:  # noqa: BLE001
+            self._disable(f"plan failed: {exc!r}")
+            return None
+        old_ptr, old_cap, n_graphs = self._kv_buf_ptr, self._kv_cap, len(self.graphs)
+        if not self._scratch_ok(model_runner):
+            # the updater's kv_indices scratch was reallocated since capture: every
+            # captured launch points at freed memory. Retire the whole generation --
+            # the graphs, the private graph pool they were captured into and the cached
+            # output that pins a segment of that pool (a fresh pool is created by the
+            # next _capture; reusing the old handle after its graphs are gone trips
+            # torch's create_or_incref_pool use_count assert) -- and recapture on the
+            # current buffer (bitwise-checked like any first capture).
+            self.graphs.clear()
+            self.out_static = None
+            self.pool = None
+            self.stats["scratch_moved"] += 1
+            msg = (
+                "[SDAR-EXACT-COMMIT] kv_indices scratch moved ptr %s->%s cap %s->%s; dropped %d graphs, recapturing"
+                % (old_ptr, self._kv_buf_ptr, old_cap, self._kv_cap, n_graphs)
+            )
+            logger.warning(msg)
+            print(msg, flush=True)
+        entry = self.graphs.get(sig)
+        if entry is None:
+            try:
+                return self._capture(model_runner, forward_batch, sig)
+            except Exception as exc:  # noqa: BLE001
+                self._disable(f"capture failed: {exc!r}")
+                return None
+        entry["graph"].replay()
+        self.out_static = entry["out"]
+        self.stats["replays"] += 1
+        if _CHECK_EVERY:
+            torch.cuda.synchronize()
+            rep_logits = self.out_static.full_logits.clone()
+            rep_kv = self._snapshot_kv(model_runner, forward_batch.out_cache_loc)
+            # (a) eager with the DEDICATED wrappers (plan on forward_batch + forward)
+            saved_w = self._swap_in(model_runner)
+            try:
+                model_runner.attn_backend.init_forward_metadata(forward_batch)
+                out_ded = model_runner.forward(forward_batch, skip_attn_backend_init=True)
+                torch.cuda.synchronize()
+                ded_logits = out_ded.logits_output.full_logits.clone()
+                ded_kv = self._snapshot_kv(model_runner, forward_batch.out_cache_loc)
+                del out_ded
+            finally:
+                self._swap_out(model_runner, saved_w)
+            # (b) eager with the backend's normal wrappers (reference)
+            model_runner.attn_backend.init_forward_metadata(forward_batch)
+            out = model_runner.forward(forward_batch, skip_attn_backend_init=True)
+            torch.cuda.synchronize()
+            eag_kv = self._snapshot_kv(model_runner, forward_batch.out_cache_loc)
+            d_ded = (rep_logits.float() - ded_logits.float()).abs().max().item()
+            d_ded_eag = (ded_logits.float() - out.logits_output.full_logits.float()).abs().max().item()
+            print(
+                "[SDAR-EXACT-COMMIT-CHECK] replay vs eager-dedicated max|d|=%.3e ; eager-dedicated vs eager-original max|d|=%.3e ; kv(ded vs orig) L1 K%.2e"
+                % (d_ded, d_ded_eag, (ded_kv[1][0].float() - eag_kv[1][0].float()).abs().max().item() if len(ded_kv) > 1 else -1.0),
+                flush=True,
+            )
+            d = (rep_logits.float() - out.logits_output.full_logits.float()).abs()
+            kvd = " ".join(
+                "L%d K%.2e V%.2e" % (i, (a[0].float() - b[0].float()).abs().max().item(), (a[1].float() - b[1].float()).abs().max().item())
+                for i, (a, b) in enumerate(zip(rep_kv, eag_kv))
+            )
+            print(
+                "[SDAR-EXACT-COMMIT-CHECK] replay#%d prefix=%d logits max|d|=%.3e rows_diff=%d/%d | kv: %s | static ids==new: %s pos==: %s loc==: %s"
+                % (
+                    self.stats["replays"], int(forward_batch.extend_prefix_lens_cpu[0]), d.max().item(),
+                    int((d.max(dim=-1).values > 0).sum().item()), d.shape[0], kvd,
+                    bool(torch.equal(self.fb_static.input_ids, forward_batch.input_ids)),
+                    bool(torch.equal(self.fb_static.positions, forward_batch.positions)),
+                    bool(torch.equal(self.fb_static.out_cache_loc, forward_batch.out_cache_loc)),
+                ),
+                flush=True,
+            )
+            return _Result(logits_output=out.logits_output, graph_was_replayed=False)
+        return _Result(logits_output=self.out_static)
+
+    # ------------------------------------------------------------------
+    @staticmethod
+    def _sync_static(fb_static, fb):
+        fb_static.input_ids.copy_(fb.input_ids)
+        fb_static.positions.copy_(fb.positions)
+        fb_static.out_cache_loc.copy_(fb.out_cache_loc)
+        fb_static.req_pool_indices.copy_(fb.req_pool_indices)
+        fb_static.seq_lens.copy_(fb.seq_lens)
+        if fb.extend_prefix_lens is not None:
+            fb_static.extend_prefix_lens.copy_(fb.extend_prefix_lens)
+        if fb.extend_seq_lens is not None:
+            fb_static.extend_seq_lens.copy_(fb.extend_seq_lens)
+        if fb.extend_start_loc is not None and fb_static.extend_start_loc is not None:
+            fb_static.extend_start_loc.copy_(fb.extend_start_loc)
+        if fb.seq_lens_cpu is not None:
+            if fb_static.seq_lens_cpu is None or fb_static.seq_lens_cpu.shape != fb.seq_lens_cpu.shape:
+                fb_static.seq_lens_cpu = fb.seq_lens_cpu.clone()
+            else:
+                fb_static.seq_lens_cpu.copy_(fb.seq_lens_cpu)
+        fb_static.seq_lens_sum = int(fb.seq_lens_sum)
+        fb_static.extend_num_tokens = fb.extend_num_tokens
+        fb_static.extend_prefix_lens_cpu = list(fb.extend_prefix_lens_cpu) if fb.extend_prefix_lens_cpu is not None else None
+        fb_static.extend_seq_lens_cpu = list(fb.extend_seq_lens_cpu) if fb.extend_seq_lens_cpu is not None else None
+        if getattr(fb, "orig_seq_lens", None) is not None and getattr(fb_static, "orig_seq_lens", None) is not None:
+            fb_static.orig_seq_lens.copy_(fb.orig_seq_lens)
+
+    def _swap_in(self, model_runner):
+        be = model_runner.attn_backend
+        upd = be.indices_updater_prefill
+        ragged, paged = self.wrappers
+        saved = (be.prefill_wrapper_ragged, upd.prefill_wrapper_ragged, be.prefill_wrappers_paged)
+        be.prefill_wrapper_ragged = ragged
+        upd.prefill_wrapper_ragged = ragged
+        be.prefill_wrappers_paged = paged
+        return saved
+
+    @staticmethod
+    def _swap_out(model_runner, saved):
+        be = model_runner.attn_backend
+        upd = be.indices_updater_prefill
+        be.prefill_wrapper_ragged, upd.prefill_wrapper_ragged, be.prefill_wrappers_paged = saved
+
+    def _plan(self, model_runner, fb_static):
+        """Host-side flashinfer plan of the dedicated wrappers for this block's
+        prefix through the backend's normal extend metadata path (the wrappers
+        are swapped in only for the plan; the captured kernels hold them)."""
+        saved = self._swap_in(model_runner)
+        try:
+            model_runner.attn_backend.init_forward_metadata(fb_static)
+            self._metadata = model_runner.attn_backend.forward_metadata
+        finally:
+            self._swap_out(model_runner, saved)
+
+    def _snapshot_kv(self, model_runner, loc):
+        pool = model_runner.token_to_kv_pool
+        L = model_runner.model_config.num_hidden_layers
+        layers = sorted({0, L // 2, L - 1})[: self.check_layers]
+        return [
+            (pool.get_key_buffer(l)[loc].clone(), pool.get_value_buffer(l)[loc].clone())
+            for l in layers
+        ]
+
+    def _make_wrappers(self, model_runner, device):
+        from flashinfer import (
+            BatchPrefillWithPagedKVCacheWrapper,
+            BatchPrefillWithRaggedKVCacheWrapper,
+        )
+
+        be = model_runner.attn_backend
+        ws = be.workspace_buffer  # scratch; stream-ordered use only
+        # eager-mode wrappers with the SAME backends as the backend's own (the
+        # ragged wrapper is built with fmha "auto" -> FA3 on Hopper, the paged
+        # ones with prefill_backend; mixing them changes the attention numerics)
+        ragged_backend = getattr(be.prefill_wrapper_ragged, "_backend", None) or "auto"
+        paged_backend = getattr(be.prefill_wrappers_paged[0], "_backend", None) or getattr(
+            be, "prefill_backend", "auto"
+        ) or "auto"
+        ragged = BatchPrefillWithRaggedKVCacheWrapper(ws, "NHD", backend=ragged_backend)
+        paged = [
+            BatchPrefillWithPagedKVCacheWrapper(ws, "NHD", backend=paged_backend)
+            for _ in range(int(be.num_wrappers))
+        ]
+        print("[SDAR-EXACT-COMMIT] wrappers ragged=%s paged=%s" % (ragged_backend, paged_backend), flush=True)
+        # the updater's kv_indices scratch must never be reallocated (the captured
+        # kernels hold its pointer): pre-grow it once to cover every forward the
+        # server can issue. The eager updater needs paged_len + 256 entries and
+        # reallocates when short; the ragged commit plan has paged_len = prefix
+        # <= context_len, the paged denoise plan has paged_len = seq_len, which the
+        # dLLM scheduler lets overshoot context_len by < block_size on the last
+        # block. context_len + 256 + block_size (or the env floor, whichever is
+        # larger) therefore covers both; the runtime pointer check in run() covers
+        # anything else.
+        upd = be.indices_updater_prefill
+        ctx = int(getattr(be, "max_context_len", 0) or 0)
+        cap = max(_MAX_KV, ctx + 256 + self.block_size)
+        buf = getattr(upd, "_kv_indices_buf", None)
+        if buf is None or buf.shape[0] < cap:
+            upd._kv_indices_buf = torch.zeros((cap,), dtype=torch.int32, device=device)
+        self._kv_cap = int(upd._kv_indices_buf.shape[0])
+        self._kv_buf_ptr = int(upd._kv_indices_buf.data_ptr())
+        print(
+            "[SDAR-EXACT-COMMIT] kv_indices scratch capacity=%d (context_len=%d, env floor=%d)"
+            % (self._kv_cap, ctx, _MAX_KV),
+            flush=True,
+        )
+        return ragged, paged
+
+    def _scratch_ok(self, model_runner) -> bool:
+        """True when the updater's kv_indices scratch is still the buffer the
+        captured graphs were recorded against; refreshes the recorded pointer
+        and capacity otherwise so the next capture is consistent."""
+        upd = model_runner.attn_backend.indices_updater_prefill
+        buf = getattr(upd, "_kv_indices_buf", None)
+        if buf is None:
+            self._kv_buf_ptr = None
+            self._kv_cap = None
+            return False
+        ptr = int(buf.data_ptr())
+        if ptr == self._kv_buf_ptr and int(buf.shape[0]) == self._kv_cap:
+            return True
+        self._kv_buf_ptr = ptr
+        self._kv_cap = int(buf.shape[0])
+        return False
+
+    def _ensure_wrappers(self, model_runner, device):
+        if self.wrappers is None:
+            self.wrappers = self._make_wrappers(model_runner, device)
+
+    def _make_static(self, forward_batch):
+        fb = dataclasses.replace(
+            forward_batch,
+            input_ids=forward_batch.input_ids.clone(),
+            positions=forward_batch.positions.clone(),
+            out_cache_loc=forward_batch.out_cache_loc.clone(),
+            req_pool_indices=forward_batch.req_pool_indices.clone(),
+            seq_lens=forward_batch.seq_lens.clone(),
+            extend_prefix_lens=(
+                forward_batch.extend_prefix_lens.clone()
+                if forward_batch.extend_prefix_lens is not None else None
+            ),
+            extend_seq_lens=(
+                forward_batch.extend_seq_lens.clone()
+                if forward_batch.extend_seq_lens is not None else None
+            ),
+            extend_start_loc=(
+                forward_batch.extend_start_loc.clone()
+                if forward_batch.extend_start_loc is not None else None
+            ),
+        )
+        if forward_batch.seq_lens_cpu is not None:
+            fb.seq_lens_cpu = forward_batch.seq_lens_cpu.clone()
+        if getattr(forward_batch, "orig_seq_lens", None) is not None:
+            fb.orig_seq_lens = forward_batch.orig_seq_lens.clone()
+        fb.return_logprob = False
+        fb.disable_cuda_graph_once = True  # eager model_runner.forward inside the capture
+        return fb
+
+    def _capture(self, model_runner, forward_batch, sig):
+        t0 = time.perf_counter()
+        fb = self.fb_static  # synced + planned for this block by run()
+
+        # eager reference + capture with the dedicated wrappers in place
+        be = model_runner.attn_backend
+        saved_md = be.forward_metadata
+        saved_w = self._swap_in(model_runner)
+        try:
+            be.init_forward_metadata(fb)
+            self._metadata = be.forward_metadata
+            out_ref = model_runner.forward(fb, skip_attn_backend_init=True)
+            ref_logits = out_ref.logits_output.full_logits.clone()
+            del out_ref
+            torch.cuda.synchronize()
+            ref_kv = self._snapshot_kv(model_runner, fb.out_cache_loc)
+
+            if self.pool is None:
+                self.pool = torch.cuda.graph_pool_handle()
+            if self.stream is None:
+                self.stream = torch.cuda.Stream()
+            graph = torch.cuda.CUDAGraph()
+            stream = self.stream
+            stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(stream):
+                with torch.cuda.graph(graph, pool=self.pool, stream=stream):
+                    out_static = model_runner.forward(fb, skip_attn_backend_init=True)
+            torch.cuda.current_stream().wait_stream(stream)
+            torch.cuda.synchronize()
+
+            # bitwise check: replay must reproduce the eager forward
+            graph.replay()
+            torch.cuda.synchronize()
+            same = bool(torch.equal(out_static.logits_output.full_logits, ref_logits))
+            kv_now = self._snapshot_kv(model_runner, fb.out_cache_loc)
+            for (k0, v0), (k1, v1) in zip(ref_kv, kv_now):
+                same = same and bool(torch.equal(k0, k1)) and bool(torch.equal(v0, v1))
+        finally:
+            self._swap_out(model_runner, saved_w)
+            be.forward_metadata = saved_md
+        if not same:
+            self._disable("replay not bitwise equal to eager commit forward")
+            # K/V slots hold the replayed values; rerun eager to leave the cache exact
+            model_runner.attn_backend.init_forward_metadata(forward_batch)
+            out = model_runner.forward(forward_batch, skip_attn_backend_init=True)
+            return _Result(
+                logits_output=out.logits_output, graph_was_replayed=False,
+                graph_replay_miss_reason="exact_commit_mismatch", can_run_graph=False,
+            )
+        self.graphs[sig] = {"graph": graph, "out": out_static.logits_output}
+        self.out_static = out_static.logits_output
+        # record the scratch the captured launches actually point at
+        upd = model_runner.attn_backend.indices_updater_prefill
+        buf = getattr(upd, "_kv_indices_buf", None)
+        if buf is not None:
+            self._kv_buf_ptr = int(buf.data_ptr())
+            self._kv_cap = int(buf.shape[0])
+        dt = time.perf_counter() - t0
+        self.stats["captures"] += 1
+        self.stats["capture_s"] += dt
+        msg = "[SDAR-EXACT-COMMIT] captured commit graph #%d (block=%d, prefix=%d, %.2fs, bitwise ok)" % (
+            len(self.graphs), self.block_size, int(fb.extend_prefix_lens_cpu[0]), dt)
+        logger.info(msg)
+        print(msg, flush=True)
+        return _Result(logits_output=self.out_static)
+
+    def _disable(self, reason: str):
+        self.disabled = True
+        self.disabled_reason = reason
+        msg = f"[SDAR-EXACT-COMMIT] disabled: {reason}"
+        logger.warning(msg)
+        print(msg, flush=True)
