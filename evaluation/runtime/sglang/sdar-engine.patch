+def post_step_fused(order, sorted_e, excl, acc_tmp, accepted, prompt, ids, proposal, pprobs, slp,
+                    qprobs, qslp, counts, status, step_t, block_t, bound, edit_thr, seed, high,
+                    force_leftmost: bool):
+    n = int(ids.numel())
+    block = 1
+    while block < n:
+        block *= 2
+    _post_step_kernel[(1,)](
+        order, sorted_e, excl, acc_tmp, accepted, prompt, ids, proposal, pprobs, slp,
+        qprobs, qslp, counts, status, step_t, block_t,
+        n, float(bound), float(edit_thr), int(seed), int(high),
+        FORCE_LEFTMOST=bool(force_leftmost), IDS_INT32=(ids.dtype == torch.int32), BLOCK=block, num_warps=4,
+    )
