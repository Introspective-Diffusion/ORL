+@triton.jit
+def _post_step_kernel(
+    ORDER, SORTED_E, EXCL,          # sort of where(eligible, entropy, +inf): indices, values, exclusive cumsum
+    ACC_TMP,                         # int8 scratch [n] for the scatter
+    ACCEPTED, PROMPT, IDS,           # bool, bool, ids (in/out)
+    PROPOSAL, PPROBS, SLP,           # int64, fp32, fp32
+    QPROBS, QSLP,                    # fp32 in/out
+    COUNTS, STATUS, STEP_T, BLOCK_T, # int64[2] in/out, bool[2] out, int64 scalar in/out, int64 scalar
+    n, bound, edit_thr, seed, high,
+    FORCE_LEFTMOST: tl.constexpr,
+    IDS_INT32: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """Everything after sort/cumsum of the fixed-shape entropy-bound step, in one
+    program: accept scatter + force-leftmost, edit mask, block status, the
+    where-updates of ids / q_probs / q_sample_logprobs, accept/edit counters,
+    step counter and the next step's random-vocab noise. Integer / boolean /
+    comparison arithmetic only (no float reductions), so the results are
+    identical to the torch chain."""
+    offs = tl.arange(0, BLOCK)
+    m = offs < n
+    order = tl.load(ORDER + offs, mask=m, other=0)
+    se = tl.load(SORTED_E + offs, mask=m, other=float("inf"))
+    excl = tl.load(EXCL + offs, mask=m, other=float("inf"))
+    sel_sorted = (excl <= bound) & (se < float("inf")) & m
+    tl.store(ACC_TMP + order, sel_sorted.to(tl.int8), mask=m)
+    tl.debug_barrier()
+    accept = (tl.load(ACC_TMP + offs, mask=m, other=0) != 0) & m
+    accepted = (tl.load(ACCEPTED + offs, mask=m, other=0) != 0)
+    prompt = (tl.load(PROMPT + offs, mask=m, other=0) != 0)
+    eligible = (~accepted) & (~prompt) & m
+    if FORCE_LEFTMOST:
+        none = tl.sum(accept.to(tl.int32), 0) == 0
+        first = tl.min(tl.where(eligible, offs, n), 0)
+        accept = accept | (none & eligible & (offs == first))
+    ids = tl.load(IDS + offs, mask=m, other=0).to(tl.int64)
+    proposal = tl.load(PROPOSAL + offs, mask=m, other=0)
+    if IDS_INT32:
+        proposal_cast = proposal.to(tl.int32).to(tl.int64)
+    else:
+        proposal_cast = proposal
+    pp = tl.load(PPROBS + offs, mask=m, other=0.0)
+    edit = accepted & (~prompt) & (pp > edit_thr) & (proposal_cast != ids) & m
+    accepted_new = accepted | accept
+    # status: done, changed
+    done = tl.sum(((~accepted_new) & m).to(tl.int32), 0) == 0
+    changed = tl.sum((accept | edit).to(tl.int32), 0) > 0
+    tl.store(STATUS, done.to(tl.int8))
+    tl.store(STATUS + 1, changed.to(tl.int8))
+    upd = accept | edit
+    ids_new = tl.where(upd, proposal_cast, ids)
+    slp = tl.load(SLP + offs, mask=m, other=0.0)
+    qp = tl.load(QPROBS + offs, mask=m, other=0.0)
+    qs = tl.load(QSLP + offs, mask=m, other=0.0)
+    tl.store(QPROBS + offs, tl.where(upd, pp, qp), mask=m)
+    tl.store(QSLP + offs, tl.where(upd, slp, qs), mask=m)
+    tl.store(ACCEPTED + offs, accepted_new.to(tl.int8), mask=m)
+    c0 = tl.load(COUNTS)
+    c1 = tl.load(COUNTS + 1)
+    tl.store(COUNTS, c0 + tl.sum(accept.to(tl.int64), 0))
+    tl.store(COUNTS + 1, c1 + tl.sum(edit.to(tl.int64), 0))
+    step = tl.load(STEP_T) + 1
+    tl.store(STEP_T, step)
+    blk = tl.load(BLOCK_T)
+    pos = offs.to(tl.int64) + blk * n
+    fill = ((pos + 1) * 1103515245 + (step + 1) * 12345 + seed) % high
+    if IDS_INT32:
+        fill = fill.to(tl.int32).to(tl.int64)
+    ids_final = tl.where(accepted_new, ids_new, fill)
+    if IDS_INT32:
+        tl.store(IDS + offs, ids_final.to(tl.int32), mask=m)
+    else:
+        tl.store(IDS + offs, ids_final, mask=m)
+
