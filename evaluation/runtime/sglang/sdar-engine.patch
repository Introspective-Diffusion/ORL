@@ -0,0 +1,236 @@
+"""Exact CUDA-graph replay of the SDARPrefixKV per-step post-processing.
+
+After every denoise forward the fixed-shape step (SDAR_FIXED_SHAPE_STEP) runs
+~50 small launches: fused row stats (argmax / confidence / entropy at the
+step's confidence temperature), the fixed-shape entropy-bound accept mask, the
+edit mask, the (done, changed) status copy, the where-updates of the block ids
+and per-position probabilities, the accept/edit counters and the next step's
+random-vocab noise. All shapes are static and the logits live in the graph
+runner's static output buffer, so the whole chain is captured once per logits
+buffer and replayed. Same kernels, same values (the per-step temperature and
+the step counter are device scalars advanced inside the graph; the confidence
+temperature table is precomputed with the same float rounding as the eager
+path).
+
+State mirrors (ids / accepted / prompt / q_probs / q_sample_logprobs / counters)
+live in static buffers for the duration of a block; the caller copies the ids
+back into the ForwardBatch view after each step.
+
+SDAR_POST_GRAPH=1 enables it (default on with SDAR_FUSED_ROW_STATS=1).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_ENABLED = os.environ.get("SDAR_POST_GRAPH", "1") == "1"
+# SDAR_POST_FUSED_TAIL=1 (default): after sort/cumsum, run the accept scatter, edit
+# mask, status, updates, counters and next-step noise as ONE Triton kernel
+# (fused_step_kernels.post_step_fused) instead of ~35 torch launches; integer /
+# boolean / comparison arithmetic only, so the values are identical.
+_FUSED_TAIL = os.environ.get("SDAR_POST_FUSED_TAIL", "1") == "1"
+
+
+class ExactPostStepGraphs:
+    def __init__(self, algo, block_size: int, vocab: int, device, ids_dtype):
+        self.algo = algo
+        self.n = int(block_size)
+        self.disabled = not _ENABLED
+        self.disabled_reason = None
+        self.graphs: dict[int, dict] = {}
+        self.pool = None
+        self.stream = None
+        self.stats = {"replays": 0, "captures": 0}
+        n = self.n
+        f32 = torch.float32
+        self.ids = torch.zeros((n,), dtype=ids_dtype, device=device)
+        self.accepted = torch.zeros((n,), dtype=torch.bool, device=device)
+        self.prompt = torch.zeros((n,), dtype=torch.bool, device=device)
+        self.q_probs = torch.full((n,), float("nan"), dtype=f32, device=device)
+        self.q_slp = torch.full((n,), float("nan"), dtype=f32, device=device)
+        self.counts = torch.zeros((2,), dtype=torch.int64, device=device)
+        self.boundary = torch.zeros((vocab,), dtype=f32, device=device)
+        self.step_t = torch.zeros((), dtype=torch.int64, device=device)  # denoise step counter
+        self.block_t = torch.zeros((), dtype=torch.int64, device=device)
+        self.positions = torch.arange(n, device=device)
+        self.status_dev = torch.zeros((2,), dtype=torch.bool, device=device)
+        self.acc_tmp = torch.zeros((n,), dtype=torch.int8, device=device)
+        self.status_pinned = torch.empty((2,), dtype=torch.bool, pin_memory=True)
+        self.event = torch.cuda.Event()
+        # confidence temperature table: step (1-based) -> fp32(1/T_step), same
+        # rounding as the eager path (python float 1/T -> fp32 kernel arg)
+        max_steps = int(algo.max_steps_per_block) + 2
+        inv = []
+        for step in range(0, max_steps + 1):
+            step_capped = min(max(step, 1), int(algo.max_steps_per_block))
+            if algo.confidence_temperature_mode == "step_linear":
+                T = max(
+                    algo.confidence_temperature_min,
+                    algo.confidence_temperature_max
+                    - algo.confidence_temperature_step_decrement * float(max(step_capped - 1, 0)),
+                )
+            else:
+                T = float(algo.confidence_temperature)
+            inv.append(1.0 / max(float(T), 1e-6))
+        self.inv_t_table = torch.tensor(inv, dtype=torch.float32, device=device)
+        self._ids_dtype = ids_dtype
+
+    # ------------------------------------------------------------------
+    def begin_block(self, block_input_ids, accepted_mask, prompt_mask, block_idx: int):
+        self.ids.copy_(block_input_ids)
+        self.accepted.copy_(accepted_mask)
+        self.prompt.copy_(prompt_mask)
+        self.q_probs.fill_(float("nan"))
+        self.q_slp.fill_(float("nan"))
+        self.counts.zero_()
+        self.step_t.zero_()
+        self.block_t.fill_(int(block_idx))
+
+    def step(self, raw_logits, boundary):
+        """One post-processing step. Returns (done, changed) after the single sync."""
+        key = int(raw_logits.data_ptr())
+        entry = self.graphs.get(key)
+        self.boundary.copy_(boundary)
+        if entry is None:
+            entry = self._capture(key, raw_logits)
+            if entry is None:
+                return None
+        else:
+            entry["graph"].replay()
+        self.event.record()
+        self.stats["replays"] += 1
+        self.event.synchronize()
+        done, changed = self.status_pinned.tolist()
+        return bool(done), bool(changed)
+
+    # ------------------------------------------------------------------
+    def _body(self, raw_logits):
+        from sglang.srt.dllm.algorithm.fused_step_kernels import row_stats_temp_dev
+
+        algo = self.algo
+        step_now = self.step_t + 1  # this step's 1-based index
+        # index_select (not tensor[idx]: a 0-dim index would be read back to the
+        # host, which is illegal during graph capture)
+        inv_t = torch.index_select(
+            self.inv_t_table, 0, step_now.clamp(max=self.inv_t_table.numel() - 1).view(1)
+        )
+        pb, cb, eb, _ = row_stats_temp_dev(self.boundary.unsqueeze(0), inv_t)
+        pr, cr, er, _ = row_stats_temp_dev(raw_logits[:-1], inv_t)
+        proposal = torch.cat([pb, pr])
+        proposal_probs = torch.cat([cb, cr])
+        entropy = torch.cat([eb, er])
+        sample_logprobs = proposal_probs.clamp_min(torch.finfo(proposal_probs.dtype).tiny).log()
+        if _FUSED_TAIL and algo.noise_mode == "random_vocab" and self._ids_dtype in (torch.int32, torch.int64):
+            from sglang.srt.dllm.algorithm.fused_step_kernels import post_step_fused
+
+            unresolved = (~self.accepted) & (~self.prompt)
+            masked = torch.where(unresolved, entropy, float("inf"))
+            sorted_entropy, order = torch.sort(masked, descending=False)
+            excl = torch.cumsum(sorted_entropy, dim=-1) - sorted_entropy
+            post_step_fused(
+                order, sorted_entropy, excl, self.acc_tmp, self.accepted, self.prompt, self.ids,
+                proposal, proposal_probs, sample_logprobs, self.q_probs, self.q_slp,
+                self.counts, self.status_dev, self.step_t, self.block_t,
+                algo.entropy_bound, algo.edit_threshold, int(algo.randtok_seed), int(algo.random_token_high),
+                bool(algo.force_accept_leftmost),
+            )
+            self.status_pinned.copy_(self.status_dev, non_blocking=True)
+            return
+        proposal_cast = proposal.to(self._ids_dtype)
+        unresolved = (~self.accepted) & (~self.prompt)
+        accept = algo._build_accept_mask_fixed(unresolved, entropy)
+        edit = (
+            self.accepted
+            & (~self.prompt)
+            & (proposal_probs > algo.edit_threshold)
+            & (proposal_cast != self.ids)
+        )
+        accepted_new = self.accepted | accept
+        status = torch.stack([accepted_new.all(), accept.any() | edit.any()])
+        self.status_dev.copy_(status)
+        self.status_pinned.copy_(self.status_dev, non_blocking=True)
+        self.ids.copy_(torch.where(accept, proposal_cast, self.ids))
+        self.q_probs.copy_(torch.where(accept, proposal_probs.float(), self.q_probs))
+        self.q_slp.copy_(torch.where(accept, sample_logprobs.float(), self.q_slp))
+        self.ids.copy_(torch.where(edit, proposal_cast, self.ids))
+        self.q_probs.copy_(torch.where(edit, proposal_probs.float(), self.q_probs))
+        self.q_slp.copy_(torch.where(edit, sample_logprobs.float(), self.q_slp))
+        self.accepted.copy_(accepted_new)
+        self.counts[0].add_(accept.sum())
+        self.counts[1].add_(edit.sum())
+        self.step_t.add_(1)
+        # next-step noise (a no-op on the values when the block just completed)
+        pos = self.positions + self.block_t * self.n
+        fill = (
+            (pos + 1) * 1103515245 + (self.step_t + 1) * 12345 + algo.randtok_seed
+        ).remainder(algo.random_token_high).to(self._ids_dtype)
+        if algo.noise_mode == "mask":
+            fill = torch.full_like(self.ids, algo.mask_id)
+        self.ids.copy_(torch.where(self.accepted, self.ids, fill))
+
+    def _capture(self, key, raw_logits):
+        t0 = time.perf_counter()
+        # snapshot the block state, run eagerly once (reference), restore, capture, replay, compare
+        snap = {k: getattr(self, k).clone() for k in ("ids", "accepted", "q_probs", "q_slp", "counts", "step_t")}
+        try:
+            self._body(raw_logits)
+            torch.cuda.synchronize()
+            ref = {k: getattr(self, k).clone() for k in snap}
+            ref_status = self.status_pinned.clone()
+            for k, v in snap.items():
+                getattr(self, k).copy_(v)
+            if self.pool is None:
+                self.pool = torch.cuda.graph_pool_handle()
+            if self.stream is None:
+                self.stream = torch.cuda.Stream()
+            graph = torch.cuda.CUDAGraph()
+            stream = self.stream
+            stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(stream):
+                with torch.cuda.graph(graph, pool=self.pool, stream=stream):
+                    self._body(raw_logits)
+            torch.cuda.current_stream().wait_stream(stream)
+            torch.cuda.synchronize()
+            # the capture itself does not execute; replay once from the snapshot
+            for k, v in snap.items():
+                getattr(self, k).copy_(v)
+            graph.replay()
+            torch.cuda.synchronize()
+            def _bits(x):
+                # bit-exact compare (NaN-safe: q_probs / q_slp hold NaN for unresolved rows)
+                return x.view(torch.int32) if x.dtype == torch.float32 else x
+
+            same = bool(torch.equal(self.status_pinned, ref_status))
+            for k in snap:
+                same = same and bool(torch.equal(_bits(getattr(self, k)), _bits(ref[k])))
+        except Exception as exc:  # noqa: BLE001
+            self._disable(f"capture failed: {exc!r}")
+            for k, v in snap.items():
+                getattr(self, k).copy_(v)
+            return None
+        if not same:
+            self._disable("replay not bitwise equal to eager post-processing")
+            for k, v in snap.items():
+                getattr(self, k).copy_(v)
+            return None
+        entry = {"graph": graph}
+        self.graphs[key] = entry
+        self.stats["captures"] += 1
+        msg = "[SDAR-EXACT-POST] captured post-step graph #%d (%.3fs, bitwise ok)" % (
+            len(self.graphs), time.perf_counter() - t0)
+        logger.info(msg)
+        print(msg, flush=True)
+        return entry
+
+    def _disable(self, reason: str):
+        self.disabled = True
+        self.disabled_reason = reason
+        msg = f"[SDAR-EXACT-POST] disabled: {reason}"
+        logger.warning(msg)
+        print(msg, flush=True)
