+def row_stats_temp_dev(logits: torch.Tensor, inv_t: torch.Tensor):
+    """row_stats_temp with inv_t (= 1/T, fp32) as a 0-dim/1-element device tensor."""
+    assert logits.ndim == 2 and logits.is_cuda
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    n, v = logits.shape
