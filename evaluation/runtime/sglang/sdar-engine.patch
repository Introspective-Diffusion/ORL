--- a/inference/sglang/sglang/srt/dllm/algorithm/fused_step_kernels.py
+++ b/inference/sglang/sglang/srt/dllm/algorithm/fused_step_kernels.py
@@ -232,3 +232,276 @@ def row_conf_prob_ctrl(
         HAS_PREV=has_prev, BLOCK=_BLOCK, num_warps=8,
     )
     return out_p, out_t
+
+
+@triton.jit
+def _row_stats_temp_kernel(
+    X,
+    stride_x,
+    V,
+    inv_t,
+    AMAX,
+    PMAX,
+    ENT,
+    LSE,
+    BLOCK: tl.constexpr,
+):
+    """One pass over a logits row at confidence temperature T (inv_t = 1/T):
+    argmax (first index), softmax(x/T)[argmax] = 1 / sum_j exp((x_j - m)/T),
+    entropy of softmax(x/T) in nats = log s - t/s with
+    s = sum exp(u_j), t = sum u_j exp(u_j), u_j = (x_j - m)/T, and logsumexp(x/T)."""
+    row = tl.program_id(0)
+    xp = X + row.to(tl.int64) * stride_x
+    m = tl.full((), -1.0e30, tl.float32)
+    s = tl.zeros((), tl.float32)
+    t = tl.zeros((), tl.float32)
+    best_idx = tl.full((), 2**31 - 1, tl.int32)
+    for start in range(0, V, BLOCK):
+        offs = start + tl.arange(0, BLOCK)
+        mask = offs < V
+        x = tl.load(xp + offs, mask=mask, other=float("-inf")).to(tl.float32)
+        cm = tl.max(x, 0)
+        m_new = tl.maximum(m, cm)
+        alpha = tl.exp((m - m_new) * inv_t)
+        u = (x - m_new) * inv_t
+        e = tl.exp(u)
+        s_chunk = tl.sum(e, 0)
+        t_chunk = tl.sum(tl.where(mask, u * e, 0.0), 0)
+        t = alpha * (t + (m - m_new) * inv_t * s) + t_chunk
+        s = alpha * s + s_chunk
+        idx_c = tl.min(tl.where(x == cm, offs, 2**31 - 1), 0)
+        best_idx = tl.where(cm > m, idx_c, best_idx)
+        m = m_new
+    log_s = tl.log(s)
+    tl.store(AMAX + row, best_idx.to(tl.int64))
+    tl.store(PMAX + row, 1.0 / s)
+    tl.store(ENT + row, log_s - t / s)
+    tl.store(LSE + row, m * inv_t + log_s)
+
+
+def row_stats_temp(
+    logits: torch.Tensor, temperature: float
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """(argmax[int64], softmax(x/T)[argmax], entropy(softmax(x/T)), logsumexp(x/T))
+    per row in one read of the logits (fp32 or bf16 input, fp32 math).
+    Replaces argmax + x/T + softmax + gather + p*log(p) sum of the torch path;
+    values agree up to fp32 summation-order noise."""
+    assert logits.ndim == 2 and logits.is_cuda
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    n, v = logits.shape
+    inv_t = 1.0 / max(float(temperature), 1e-6)
+    amax = torch.empty(n, dtype=torch.int64, device=logits.device)
+    pmax = torch.empty(n, dtype=torch.float32, device=logits.device)
+    ent = torch.empty_like(pmax)
+    lse = torch.empty_like(pmax)
+    _row_stats_temp_kernel[(n,)](
+        logits, logits.stride(0), v, inv_t, amax, pmax, ent, lse, BLOCK=_BLOCK, num_warps=8
+    )
+    return amax, pmax, ent, lse
+
+
+@triton.jit
+def _sc_softmax_rows_kernel(
+    X,
+    stride_x,
+    V,
+    IDX,
+    OUT,
+    stride_o,
+    BLOCK: tl.constexpr,
+):
+    """OUT[r, :] = softmax(X[IDX[r], :]) for the selected rows, written directly in
+    OUT's dtype (bf16 for the self-conditioning soft-embedding matmul). Two reads
+    of the row (max/sum, then normalize) and one narrow write instead of
+    index_select + fp32 softmax + cast."""
+    r = tl.program_id(0)
+    idx = tl.load(IDX + r).to(tl.int64)
+    xp = X + idx * stride_x
+    op = OUT + r.to(tl.int64) * stride_o
+    m = tl.full((), -1.0e30, tl.float32)
+    s = tl.zeros((), tl.float32)
+    for start in range(0, V, BLOCK):
+        offs = start + tl.arange(0, BLOCK)
+        mask = offs < V
+        x = tl.load(xp + offs, mask=mask, other=float("-inf")).to(tl.float32)
+        cm = tl.max(x, 0)
+        m_new = tl.maximum(m, cm)
+        s = s * tl.exp(m - m_new) + tl.sum(tl.exp(x - m_new), 0)
+        m = m_new
+    for start in range(0, V, BLOCK):
+        offs = start + tl.arange(0, BLOCK)
+        mask = offs < V
+        x = tl.load(xp + offs, mask=mask, other=float("-inf")).to(tl.float32)
+        y = tl.exp(x - m) / s
+        tl.store(op + offs, y.to(OUT.dtype.element_ty), mask=mask)
+
+
+def sc_softmax_rows(
+    logits: torch.Tensor, indices: torch.Tensor, out_dtype: torch.dtype
+) -> torch.Tensor:
+    """softmax over the selected rows of a [rows, vocab] logits tensor, returned as
+    [len(indices), vocab] in out_dtype (temperature 1)."""
+    assert logits.ndim == 2 and logits.is_cuda and indices.ndim == 1
+    if logits.stride(1) != 1:
+        logits = logits.contiguous()
+    n = int(indices.numel())
+    v = logits.shape[1]
+    out = torch.empty((n, v), dtype=out_dtype, device=logits.device)
+    if n == 0:
+        return out
+    _sc_softmax_rows_kernel[(n,)](
+        logits, logits.stride(0), v, indices.to(torch.int64).contiguous(), out, out.stride(0),
+        BLOCK=_BLOCK, num_warps=8,
+    )
+    return out
+
+
+@triton.jit
+def _row_stats_temp_ptr_kernel(
+    X,
+    stride_x,
+    V,
+    INV_T,
+    AMAX,
+    PMAX,
+    ENT,
+    LSE,
+    BLOCK: tl.constexpr,
+):
+    """_row_stats_temp_kernel with 1/T read from a device scalar (CUDA-graph
+    capturable: the temperature changes per step without a host kernel arg)."""
+    row = tl.program_id(0)
+    inv_t = tl.load(INV_T).to(tl.float32)
+    xp = X + row.to(tl.int64) * stride_x
+    m = tl.full((), -1.0e30, tl.float32)
+    s = tl.zeros((), tl.float32)
+    t = tl.zeros((), tl.float32)
+    best_idx = tl.full((), 2**31 - 1, tl.int32)
+    for start in range(0, V, BLOCK):
+        offs = start + tl.arange(0, BLOCK)
+        mask = offs < V
+        x = tl.load(xp + offs, mask=mask, other=float("-inf")).to(tl.float32)
+        cm = tl.max(x, 0)
+        m_new = tl.maximum(m, cm)
+        alpha = tl.exp((m - m_new) * inv_t)
+        u = (x - m_new) * inv_t
+        e = tl.exp(u)
+        s_chunk = tl.sum(e, 0)
+        t_chunk = tl.sum(tl.where(mask, u * e, 0.0), 0)
+        t = alpha * (t + (m - m_new) * inv_t * s) + t_chunk
+        s = alpha * s + s_chunk
+        idx_c = tl.min(tl.where(x == cm, offs, 2**31 - 1), 0)
+        best_idx = tl.where(cm > m, idx_c, best_idx)
+        m = m_new
+    log_s = tl.log(s)
+    tl.store(AMAX + row, best_idx.to(tl.int64))
+    tl.store(PMAX + row, 1.0 / s)
+    tl.store(ENT + row, log_s - t / s)
+    tl.store(LSE + row, m * inv_t + log_s)
