+"""Exact CUDA-graph replay of the SDAR self-conditioning input construction.
+
+From the second denoise step of a block, SDARPrefixKV builds the model input
+embeddings from the previous step's logits (embedding lookup, softmax over the
+[rows, vocab] logits, soft embedding matmul with the embedding table, gated
+adapter, post-norm) -- ~20 small launches per step outside the model graph.
+For a block without prompt rows every shape is static and the logits live in
+the graph runner's static output buffer, so the whole builder can be captured
+once and replayed: same kernels, same shapes, bitwise-checked at capture.
+
+Keyed by (logits buffer pointer, rows): the first step of a block reads the
+no-embeds graph output, later steps the with-embeds graph output.
+
+SDAR_SC_PREP_GRAPH=1 enables it (default off: bitwise-exact and HE32 32/32, but the SC
+segment is GPU-bound so the measured gain was within run-to-run noise).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_ENABLED = os.environ.get("SDAR_SC_PREP_GRAPH", "0") == "1"
+
+
+class ExactSCPrepGraphs:
+    def __init__(self):
+        self.entries: dict[tuple, dict] = {}
+        self.pool = None
+        self.stream = None
+        self.disabled = not _ENABLED
+        self.disabled_reason: str | None = None
+        self.stats = {"replays": 0, "captures": 0}
+
+    def applicable(self, model, model_input_ids, prev_logits, selected_indices) -> bool:
+        if self.disabled or prev_logits is None or selected_indices is None:
+            return False
+        if not (model_input_ids.is_cuda and prev_logits.is_cuda):
+            return False
+        n = int(model_input_ids.numel())
+        # only fully generated blocks (every row self-conditioned): static shapes
+        if int(selected_indices.numel()) != n or prev_logits.shape[0] != n:
+            return False
+        if not prev_logits.is_contiguous():
+            return False
+        return True
+
+    def run(self, model, model_input_ids, prev_logits, sc_mask, selected_indices):
+        """Return the conditioned input embeddings (static tensor) or None."""
+        key = (int(prev_logits.data_ptr()), int(model_input_ids.numel()), int(prev_logits.shape[-1]))
+        entry = self.entries.get(key)
+        if entry is None:
+            try:
+                entry = self._capture(model, key, model_input_ids, prev_logits, sc_mask, selected_indices)
+            except Exception as exc:  # noqa: BLE001
+                self._disable(f"capture failed: {exc!r}")
+                return None
+            if entry is None:
+                return None
+        entry["ids"].copy_(model_input_ids)
+        entry["graph"].replay()
+        self.stats["replays"] += 1
+        return entry["out"]
+
+    def _capture(self, model, key, model_input_ids, prev_logits, sc_mask, selected_indices):
+        t0 = time.perf_counter()
+        ids = model_input_ids.clone()
+        mask = sc_mask.clone()
+        idx = selected_indices.clone()
+        # eager reference (also the value handed back for this step)
+        ref = model.build_self_conditioned_input_embeds(ids, prev_logits, mask, selected_indices=idx)
+        if ref is None:
+            return None
+        ref = ref.contiguous().clone()
+        torch.cuda.synchronize()
+        if self.pool is None:
+            self.pool = torch.cuda.graph_pool_handle()
+        if self.stream is None:
+            self.stream = torch.cuda.Stream()
+        graph = torch.cuda.CUDAGraph()
+        stream = self.stream
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            with torch.cuda.graph(graph, pool=self.pool, stream=stream):
+                out = model.build_self_conditioned_input_embeds(ids, prev_logits, mask, selected_indices=idx)
+                out = out.contiguous()
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        graph.replay()
+        torch.cuda.synchronize()
+        if not torch.equal(out, ref):
+            self._disable("replay not bitwise equal to eager self-conditioning builder")
+            return None
+        entry = {"graph": graph, "ids": ids, "mask": mask, "idx": idx, "out": out}
+        self.entries[key] = entry
+        self.stats["captures"] += 1
+        msg = "[SDAR-EXACT-SCPREP] captured key=%s (%d graphs, %.3fs, bitwise ok)" % (
+            key, len(self.entries), time.perf_counter() - t0)
+        logger.info(msg)
+        print(msg, flush=True)
+        return entry
+
+    def _disable(self, reason: str):
+        self.disabled = True
+        self.disabled_reason = reason
+        msg = f"[SDAR-EXACT-SCPREP] disabled: {reason}"
+        logger.warning(msg)
+        print(msg, flush=True)
